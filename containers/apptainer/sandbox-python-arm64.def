Bootstrap: docker
From: arm64v8/ubuntu@sha256:7f622ca8766bccb22f04242ecb6f19f770b2f08827dc4b8c707de5e78a6da7ab

%labels
    org.opencontainers.image.title sandboxed-goose-python
    org.opencontainers.image.description "Offline Python development payload for sandboxed-goose"
    org.opencontainers.image.version "0.1"
    org.opencontainers.image.base.name "arm64v8/ubuntu:24.04"
    org.opencontainers.image.base.digest "sha256:7f622ca8766bccb22f04242ecb6f19f770b2f08827dc4b8c707de5e78a6da7ab"
    io.sandboxed-goose.architecture "arm64"
    io.sandboxed-goose.profile "hostile-offline"
    io.sandboxed-goose.apt-snapshot "20260730T000000Z"

%environment
    export PATH=/usr/local/bin:/usr/bin:/bin
    export HOME=/home/sandbox
    export SHELL=/bin/bash
    export USER=sandbox
    export LOGNAME=sandbox
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export TZ=UTC
    export TMPDIR=/tmp
    export XDG_CACHE_HOME=/cache
    export XDG_CONFIG_HOME=/home/sandbox/.config
    export XDG_DATA_HOME=/home/sandbox/.local/share
    export PIP_CACHE_DIR=/cache/pip
    export PIP_DISABLE_PIP_VERSION_CHECK=1
    export PIP_NO_INDEX=1
    export PIP_NO_INPUT=1
    export PYTHONNOUSERSITE=1
    export PYTHONDONTWRITEBYTECODE=1
    export GIT_CONFIG_GLOBAL=/dev/null
    export GIT_TERMINAL_PROMPT=0
    export BASH_ENV=/dev/null
    export ENV=/dev/null
    export CI=true

%setup
    set -eu

    # Apptainer temporarily mounts generated host / resolver files while
    # running %post. Sanitize the underlying image files here, before those
    # build-time mounts exist, so none of that host state is retained.
    rm -f \
        "${APPTAINER_ROOTFS}/etc/hosts" \
        "${APPTAINER_ROOTFS}/etc/hostname" \
        "${APPTAINER_ROOTFS}/etc/localtime" \
        "${APPTAINER_ROOTFS}/etc/resolv.conf"
    printf '%s\n' \
        '127.0.0.1 localhost sandbox' \
        '::1 localhost sandbox' \
        > "${APPTAINER_ROOTFS}/etc/hosts"
    printf '%s\n' sandbox > "${APPTAINER_ROOTFS}/etc/hostname"
    : > "${APPTAINER_ROOTFS}/etc/resolv.conf"
    install -d -m 1777 \
        "${APPTAINER_ROOTFS}/tmp" \
        "${APPTAINER_ROOTFS}/var/tmp"

%post
    set -eu

    export DEBIAN_FRONTEND=noninteractive

    # The minimal OCI base does not include a CA bundle. Bootstrap only that
    # package from its signed default Ubuntu archive, then replace all sources
    # with the timestamped, signed snapshot. ca-certificates is explicitly
    # reinstalled at the snapshot version below, so the live bootstrap package
    # is not an unpinned final image input.
    apt-get update
    apt-get install -y --no-install-recommends ca-certificates

    cat > /etc/apt/sources.list.d/ubuntu.sources <<'EOF'
Types: deb
URIs: https://snapshot.ubuntu.com/ubuntu/20260730T000000Z/
Suites: noble noble-updates noble-backports noble-security
Components: main universe restricted multiverse
Signed-By: /usr/share/keyrings/ubuntu-archive-keyring.gpg
EOF

    rm -rf /var/lib/apt/lists/*
    apt-get update

    snapshot_version() {
        apt-cache madison "$1" |
            awk 'NR == 1 { print $3 }'
    }

    snapshot_ca_version="$(snapshot_version ca-certificates)"
    snapshot_openssl_version="$(snapshot_version openssl)"
    snapshot_libssl_version="$(snapshot_version libssl3t64)"
    if [ -z "$snapshot_ca_version" ] ||
        [ -z "$snapshot_openssl_version" ] ||
        [ -z "$snapshot_libssl_version" ]; then
        echo "CA bootstrap packages are missing from the Ubuntu snapshot" >&2
        exit 1
    fi

    apt-get install -y --no-install-recommends \
        --reinstall \
        --allow-downgrades \
        "ca-certificates=$snapshot_ca_version" \
        "openssl=$snapshot_openssl_version" \
        "libssl3t64=$snapshot_libssl_version"

    apt-get install -y --no-install-recommends \
        bash \
        build-essential \
        bzip2 \
        cmake \
        coreutils \
        curl \
        diffutils \
        file \
        findutils \
        gawk \
        git \
        grep \
        gzip \
        jq \
        less \
        libcap2-bin \
        ninja-build \
        patch \
        pkg-config \
        procps \
        psmisc \
        python-is-python3 \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        ripgrep \
        sed \
        tar \
        tree \
        unzip \
        wget \
        xz-utils \
        zip

    # The pinned Ubuntu base reserves UID/GID 1000 for its "ubuntu" account.
    # Remove that known base identity, then replace it with the one static
    # non-privileged sandbox account. Fail closed if the pinned base changes
    # to place an unexpected identity at either ID.
    existing_user="$(getent passwd 1000 | cut -d: -f1 || true)"
    case "$existing_user" in
        "")
            ;;
        ubuntu)
            userdel ubuntu
            rm -rf /home/ubuntu
            ;;
        *)
            echo "unexpected UID 1000 account: $existing_user" >&2
            exit 1
            ;;
    esac

    existing_group="$(getent group 1000 | cut -d: -f1 || true)"
    case "$existing_group" in
        "")
            ;;
        ubuntu)
            groupdel ubuntu
            ;;
        *)
            echo "unexpected GID 1000 group: $existing_group" >&2
            exit 1
            ;;
    esac

    groupadd --gid 1000 sandbox
    useradd \
        --uid 1000 \
        --gid 1000 \
        --home-dir /home/sandbox \
        --shell /bin/bash \
        --no-create-home \
        sandbox

    install -d -o 1000 -g 1000 -m 0700 \
        /home/sandbox \
        /home/sandbox/.config \
        /home/sandbox/.local/share
    install -d -o 1000 -g 1000 -m 0755 /workspace /cache
    install -d -o root -g root -m 0755 \
        /opt/sandboxed-goose/empty-hooks \
        /run/sandboxed-goose

    cat > /etc/gitconfig <<'EOF'
[credential]
    helper =
[core]
    hooksPath = /opt/sandboxed-goose/empty-hooks
[protocol "file"]
    allow = user
[safe]
    directory = /workspace
EOF

    cat > /etc/pip.conf <<'EOF'
[global]
disable-pip-version-check = true
no-index = true
no-input = true
EOF

    # Setid programs and file capabilities are unnecessary when arbitrary
    # unprivileged native code is already allowed. Remove them from the image.
    find / -xdev -type f \( -perm -4000 -o -perm -2000 \) \
        -exec chmod a-s {} +
    getcap -r / 2>/dev/null | while IFS= read -r capline; do
        capfile=${capline%% *}
        if [ -n "$capfile" ]; then
            setcap -r "$capfile"
        fi
    done

    apt-get clean
    rm -rf /var/lib/apt/lists/* /var/cache/apt/* /tmp/* /var/tmp/*
    chmod 1777 /tmp /var/tmp

%runscript
    exec /bin/bash --noprofile --norc "$@"

%test
    set -eu

    test "$(uname -m)" = aarch64
    test "$(getent passwd 1000 | cut -d: -f1)" = sandbox
    test "$(getent group 1000 | cut -d: -f1)" = sandbox

    command -v bash
    command -v git
    command -v python3
    command -v pip3
    command -v gcc
    command -v make
    command -v cmake
    command -v ninja
    command -v rg
    command -v jq

    python3 -c 'import ast, pathlib, sqlite3, ssl; assert (6 * 7) == 42'
    git --version

    if find / -xdev -type f \( -perm -4000 -o -perm -2000 \) \
        -print -quit | grep -q .; then
        echo "setuid or setgid file remains in image" >&2
        exit 1
    fi

    if getcap -r / 2>/dev/null | grep -q .; then
        echo "file capability remains in image" >&2
        exit 1
    fi

    test ! -e /usr/bin/sudo

%help
    This is the arm64 Python development payload for sandboxed-goose.

    It is not a sandbox by itself. Run it only through the trusted
    hostile-offline launch policy documented in docs/APPTAINER.md.
